                <div type="scheda_metrica">

                    <head>Scheda metrica</head>
                    <p>[579 : 1]
                        <lb/>Unicum
                        <lb/>a ₇ b ₇ b ₇ a ₇ c ₇' c ₇' d ₅ d ₅ a ₇ a ₇
                        <lb/>a: <rhyme type="a">or</rhyme> b: <rhyme type="b">ir</rhyme> c: <rhyme type="c">ida</rhyme> d: <rhyme type="d">an(s)</rhyme>
                    </p>
                </div>
            <div type="testo">
              <div type="txt_critico" xml:id="canso8">
                <title>Testo critico</title>
                <p>Ms. base C <lb/>Correzioni da <seg type="corr">EHV</seg>
                </p>
                <!-- Cobla I -->
                <label>I</label>
                        <lg type="stanza" n="1" rhyme="abbaccddaa">
                    <l n="1">Partit de joi e d’<rhyme label="a">amor</rhyme>,</l>
                    <l n="2">e liurat a mal <rhyme label="b">sufrir</rhyme>,</l>
                    <l n="3">
                        <seg xml:id="v3" type="diff">volgr’ieu</seg>, si pogues, <rhyme label="b">morir</rhyme>.</l>
                    <l n="4">Mas, per creisser ma <rhyme label="a">dolor</rhyme>
                    </l>
                    <l n="5">e l’ira que no m’<rhyme label="c">oblida</rhyme>,</l>
                    <l n="6">mi creis mal mon grat ma <rhyme label="c">vida</rhyme>;</l>
                    <l n="7">que solatz e <rhyme label="d">
                            <seg xml:id="v7" type="diff">chan</seg>
                        </rhyme>
                    </l>
                    <l n="8">m’es dol et <rhyme label="d">
                            <seg xml:id="v8" type="diff">afan</seg>
                        </rhyme>
                    </l>
                    <l n="9">e nuls jois no m’a <rhyme label="a">sabor</rhyme>,</l>
                    <l n="10">per qu’ieu que suelh chantar <rhyme label="a">plor</rhyme>.</l>
                </lg>
                <lb/>
                <!-- Cobla II -->
                <label>II</label>
                        <lg type="stanza" n="2" rhyme="abbaccddaa">
                    <l n="11">Sella que·m <term type="glossario">ten en <rhyme label="a">error<note type="popup" xml:id="gloss-error">
                            <label>≡ LEX</label>
                            <term type="lex">tener en error</term>
                            <def>⤷ v. | tormentare</def>
                            <ref rend="exit" target="https://archive.org/details/petitdictionnair00levyuoft/page/158/mode/2up">PD</ref>
                    </note>
                                    </rhyme>
                        </term>
                    </l>
                    <l n="12">mi sap tant en grat <rhyme label="b">servir</rhyme>
                    </l>
                    <l n="13">
                        <seg xml:id="v13" type="diff">que no vol mi sol</seg> <rhyme label="b">delir</rhyme>,</l>
                    <l n="14">ans ponh’en sa <rhyme label="a">dezonor</rhyme>;</l>
                    <l n="15">e plai li, tant <seg xml:id="v15" type="diff">es <rhyme label="c">chauzida</rhyme>
                                </seg>!
                            </l>
                    <l n="16">Pus mi a mort, quil sia <rhyme label="c">aunida</rhyme>.</l>
                    <l n="17">Qu’anta·l fora <seg xml:id="v17" type="diff">
                            <rhyme label="d">gran</rhyme>
                        </seg>
                    </l>
                    <l n="18">de mi sol l’<seg xml:id="v18" type="diff">
                                    <rhyme label="d">enjan</rhyme>,</seg>
                            </l>
                    <l n="19">per que·s tol <seg xml:id="v19" type="diff">pros</seg> et <rhyme label="a">honor</rhyme>,</l>
                    <l n="20">que blasme no·l fai <rhyme label="a">paor</rhyme>.</l>
                </lg>
                <lb/>
                <!-- Cobla III -->
                <label>III</label>
                        <lg type="stanza" n="3" rhyme="abbaccddaa">
                    <l n="21">Qu’ab bel semblant trichador</l>
                    <l n="22">mi saup gent <rhyme label="b">enfoletir</rhyme>
                    </l>
                    <l n="23">e sa falsedat <rhyme label="b">cubrir</rhyme>
                    </l>
                    <l n="24">tro m’ac pres per <rhyme label="a">servidor</rhyme>;</l>
                    <l n="25">pueis quan fo de mi <rhyme label="c">aizida</rhyme>,</l>
                    <l n="26">no·m poc <seg xml:id="v26" type="diff">far mais</seg> de <rhyme label="c">guandida</rhyme>
                    </l>
                    <l n="27">son leugier <seg xml:id="v27" type="diff">
                            <rhyme label="d">talan</rhyme>
                        </seg>
                    </l>
                    <l n="28">quans que passes l’<seg xml:id="v28" type="diff">
                                    <rhyme label="d">an</rhyme>,</seg>
                            </l>
                    <l n="29">
                        <seg xml:id="v29" type="diff">
                                    <term type="glossario">aizic<note xml:id="gloss-aizic" type="popup">
                            <label>≡ LEX ≋ LIT</label>
                            <term type="lex">aizir</term>
                            <def>⤷ v. | mettere, accogliere, favorire</def>
                            <ref rend="exit" target="https://dom-en-ligne.de/dom.php?lhid=7k163jfag9kynok7mxYjoH">DOM</ref>
                                            <lb/>
                            <def>Le due versioni del verso appaiono a prima vista equivalenti, poiché entrambe corrette dal punto di vista metrico e semantico, ma per l'edizione si condivide l’ipotesi di Gambini sulla qualità superiore di C data dalla presenza del poliptoto fra <seg type="it">aizic</seg> e il participio passato <seg type="it">aizida</seg>, in rima al v. 25, entrambe forme del verbo <seg type="it">aizir</seg>.
                                <lb/>Notare l'assenza del verbo nella costellazione EHV, in cui si legge <seg type="it">sofri maint</seg>, struttura che indica la presenza di più amanti della donna amata.
                            </def>
                        </note>
                                    </term> un fals</seg> <rhyme label="a">preiador</rhyme>
                    </l>
                    <l n="30">ab si <seg xml:id="v30" type="diff">ios</seg> son <rhyme label="a">cobertor</rhyme>.</l>
                </lg>
                <lb/>

                <!-- Cobla IV -->
                <label>IV</label>
                        <lg type="stanza" n="4" rhyme="abbaccddaa">
                    <l n="31">Aras <seg xml:id="v31" type="diff">conosc</seg> ma <rhyme label="a">folor</rhyme>,</l>
                    <l n="32">que trop saubi mal <rhyme label="b">chauzir</rhyme>.</l>
                    <l n="33">E s’anc Dieus per repentir</l>
                    <l n="34">perdonet a <rhyme label="a">peccador</rhyme>,</l>
                    <l n="35">
                        <seg xml:id="v35" type="diff">que ja per esta <rhyme label="c">falida</rhyme>,</seg>
                            </l>
                    <l n="36">m’arma no <seg xml:id="v36" type="diff">sia</seg> <rhyme label="c">delida</rhyme>.
                        </l>
                    <l n="37">
                                <seg xml:id="v37a" type="diff">Que</seg> mon cor <seg xml:id="v37b" type="diff">
                            <rhyme label="d">pessan</rhyme>
                        </seg>
                    </l>
                    <l n="38">
                        <seg xml:id="v38" type="diff">es trop <rhyme label="d">malanan</rhyme>
                        </seg>
                    </l>
                    <l n="39">
                                <seg xml:id="v39" type="diff">e</seg> tem, si Dieus no·m <rhyme label="a">socor</rhyme>,</l>
                    <l n="40">perdre mi e ma <rhyme label="a">valor</rhyme>.</l>
                </lg>
                <lb/>
                <!-- Cobla V -->
                <label>V</label>
                        <lg type="stanza" n="5" rhyme="abbaccddaa">
                    <l n="41">Qu’ieu non ai sen ni <rhyme label="a">viguor</rhyme>
                    </l>
                    <l n="42">que·m puesca de lieis <rhyme label="b">partir</rhyme>,</l>
                    <l n="43">ni·l cor lunhar ni <rhyme label="b">frezir</rhyme>
                    </l>
                    <l n="44">
                                <seg type="corr" xml:id="001">que</seg> ja non feira <rhyme label="a">clamor</rhyme>.</l>
                    <l n="45">
                                <seg xml:id="v45" type="diff">Que</seg> aitals es m’<rhyme label="c">escharida</rhyme>
                                <label/>
                    </l>
                    <l n="46">qu’a tot aital <term type="glossario">
                                    <rhyme label="c">deschauzida</rhyme>
                                <note xml:id="gloss-deschauzida" type="popup">
                                    <label>≡ LEX ≋ LIT</label>
                                    <term type="lex">deschauzida</term>
                                    <def>⤷ agg. f. | decaduta, disonorata <lb/>
                                    Dal latino [ᴅᴇᴄᴀᴅᴇ̆ʀᴇ]</def>
                                    <ref rend="exit" target="https://dom-en-ligne.de/dom.php?lhid=3B2DGpdRbggoz8tHPFVUne">DOM</ref>
                                    <lb/>
                                    <def>L’aggettivo, (qui con un esplicito riferimento a un decadimento morale) è parola-rima anche al v. 46.
                                    <lb/>Nell’antologia a cura di Sanguineti-Scarpati, la lezione <seg type="it">chauzida</seg> ("virtuosa") in C è giudicata di qualità migliore, poché trasmette un significato ironico che gli altri manoscritti non coglierebbero.</def>
                                </note>
                                </term>
                    </l>
                    <l n="47">
                        <seg xml:id="v47" type="diff">suy <rhyme label="d">humilian</rhyme>.
                        </seg>
                            </l>
                    <l n="48">Per que tot <rhyme label="d">
                            <seg xml:id="v48" type="diff">claman</seg>
                        </rhyme>
                    </l>
                    <l n="49">volgra <term type="glossario">termenes<note xml:id="gloss-termenar" type="popup">
                            <label>≡ LEX</label>
                            <term type="lex">termenar</term>
                            <def>⤷ v. | porre dei limiti, concludere<lb/>
                            Dal latino [ᴛᴇʀᴍɪɴᴀʀᴇ]
                            </def>
                            <ref rend="exit" target="https://dom-en-ligne.de/dom.php?lhid=3kq9B9O8sW8ntGO6hNQuRu">DOM</ref>
                            <lb/>
                            <def>Il verbo <seg type="it">termenar</seg> è tradotto da Levy come “poser des bornes, delimiter” e associato al sostantivo <seg type="it">terme</seg>, che si rifa appunto al concetto di “limite, confine”. In più, nella FEW si ritrovano i significati di “concludere, porre fine”, ma anche “perire, uccidere”, ed è quest’ultima la sfumatura adottata nella traduzione Shepard.
                                <lb/>Appare comunque più probabile che il <seg type="it">clamans</seg> del v. 49 non sia altri che lo stesso io lirico, soggetto singolare del verbo, seguendo un’ipotesi già avanzata da Gambini nella sua edizione. Gambini sottolinea il frequente utilizzo di Gausbert di termini legati al <seg type="it">clamar</seg> per descrivere il lamento e l’afflizione causati dalla sua condizione amorosa.</def>
                    </note>
                                </term>, <rhyme label="a">seignor</rhyme>,</l>
                    <l n="50">del <seg xml:id="v50" type="diff">gran</seg> mal de sa <rhyme label="a">calor</rhyme>.</l>
                </lg>
                <lb/>
                <!-- Tornada -->
                <label>VI</label>
                        <lg type="envoy" n="tornada" rhyme="ddaa">
                    <l n="51">Si sa calor <rhyme label="d">gran</rhyme>
                    </l>
                    <l n="52">frezis fin <rhyme label="d">aman</rhyme>,</l>
                    <l n="53">fora cautz per sa <rhyme label="a">freidor</rhyme>,</l>
                    <l n="54">quar <seg type="corr" xml:id="002">soi fregz
                            </seg> per sa <term type="glossario">
                                    <rhyme label="a">calor</rhyme>
                                    <note xml:id="gloss-calor" type="popup">
                                    <label>≋ LIT</label>
                                    <term type="lex">calor/fregz</term>
                                    <def>Il comportamento della donna amata è condannato da Gausbert in corrispondenza della tornada di chiusura della canzone, in cui il poeta lamenta il suo essere raggelato dall'ardore delle sue azioni, con esplicito riferimento ai tradimenti della donna con altri pretendenti.</def>
                                    </note>
                                </term>.</l>
                </lg>
                <lb/>
            </div>
            <!-- Apparato critico delle varianti sostanziali -->
            <div type="app_crt_sos">
              <listApp>
                 <app ana="sos">
                        <num>44</num>
                                <lem>que</lem>
                                <rdg>e<witDetail wit="#C"> C</witDetail>
                                </rdg>
                 </app> <app ana="sos">
                        <num>54</num>
                                <lem>soi fregz</lem>
                                <rdg>suefre<witDetail wit="#C"> C</witDetail>
                                </rdg>
                  </app>
              </listApp>
            </div>
            <div type="app_crt_form">
             </div>
            
            <div type="txt_costellazione" xml:id="canso8.1">

                <title>Testo di costellazione α</title>
                <p>Ms. base E <lb/>Correzioni da <seg type="corr_c">H</seg>
                </p>
                <!-- Cobla I -->
                <lg type="stanza" n="1.1" rhyme="abbaccddaa">
                    <l n="1">Partit de joi e d’<rhyme label="a">amor</rhyme>,</l>

                    <l n="2">e liurat a mal <rhyme label="b">sufrir</rhyme>,</l>

                    <l n="3">
                                <seg type="diff_c" corresp="#v3">volgra</seg>, si pogues, <rhyme label="b">morir</rhyme>.
                    </l>

                    <l n="4">Mas, per creisser ma <rhyme label="a">dolor</rhyme>
                    </l>

                    <l n="5">e l’ira que no <rhyme label="c">m’oblida</rhyme>,</l>

                    <l n="6">
                        me creis mal mon grat ma <rhyme label="c">vida</rhyme>;
                    </l>

                    <l n="7">
                        que solatz e <rhyme label="d">
                            <seg type="diff_c" corresp="#v7">chans</seg>
                        </rhyme>
                    </l>

                    <l n="8">m’es dols et <rhyme label="d">
                            <seg type="diff_c" corresp="#v8">afans</seg>
                        </rhyme>
                    </l>

                    <l n="9">
                        e <seg type="corr_c">nuls jois</seg>
                        no m’a <rhyme label="a">sabor</rhyme>,
                    </l>

                    <l n="10">
                        per qu’ieu que sueill
                        chantar <rhyme label="a">plor</rhyme>.
                    </l>
                </lg>
                <lb/>
                <!-- Cobla II -->
                <lg type="stanza" n="2.1" rhyme="abbaccddaa">

                    <l n="11">Sella que·m ten en <rhyme label="a">error</rhyme>
                    </l>

                    <l n="12">me saup tant en grat <rhyme label="b">servir</rhyme>
                    </l>

                    <l n="13">
                      <seg corresp="#v13" type="diff_c">que tot sol no·m volc</seg> <rhyme label="b">delir</rhyme>
                    </l>

                    <l n="14">ans ponh’en sa <rhyme label="a">dezonor</rhyme>;</l>

                    <l n="15">
                        e platz li, tant <seg corresp="#v15" type="diff_c">
                                    <rhyme label="c">deschauzida</rhyme>!</seg>
                    </l>

                    <l n="16"> Pos m’a mort, quill <rhyme label="c">si’aunida</rhyme>
                    </l>

                    <l n="17">C’anta·l fora <seg type="diff_c" corresp="#v17">
                        <rhyme label="d">grans</rhyme>
                                </seg>
                    </l>

                    <l n="18">
                        de mi <seg type="corr_c">sol</seg> l’<seg type="diff_c" corresp="#v18">
                                    <rhyme label="d">enguans</rhyme>,
                                </seg>
                            </l>

                    <l n="19">
                        per que·s tol <seg type="diff_c" corresp="#v19">pretz</seg> et <rhyme label="a">honor</rhyme>,                        
                    </l>

                    <l n="20">que blasme no il fai <rhyme label="a">paor</rhyme>.</l>

                </lg>
                <lb/>
                <!-- Cobla III -->
                <lg type="stanza" n="3.1" rhyme="abbaccddaa">

                    <l n="21">Ab bel semblan <rhyme label="a">trichador</rhyme>
                            </l>
                    <l n="22">
                        me saup gent <rhyme label="b">enfoletir</rhyme>
                    </l>
                    <l n="23">e sa falsedat <rhyme label="b">cubrir</rhyme>
                    </l>
                    <l n="24">tro m’ac pres per <rhyme label="a">servidor</rhyme>;</l>
                    <l n="25">
                        pueis quan fo de mi <rhyme label="c">aizida</rhyme>,
                    </l>
                    <l n="26">no·m poc <seg type="diff_c" corresp="#v26">plus far</seg> de <rhyme label="c">gandida</rhyme>
                    </l>
                    <l n="27">son leugiers <seg type="diff_c" corresp="#v27">
                            <rhyme label="d">talans</rhyme>
                        </seg>
                    </l>
                    <l n="28">quans que passes l’<seg type="diff_c" corresp="#v28">
                                    <rhyme label="d">ans</rhyme>,</seg>
                    </l>
                    <l n="29">
                        <seg type="diff_c" corresp="#v29">sofri maint fol</seg> <rhyme label="a">preiador</rhyme>
                    </l>
                    <l n="30">ab si <seg type="diff_c" corresp="#v30">sotz</seg> son <rhyme label="a">cobertor</rhyme>.</l>
                </lg>
                <lb/>
                <!-- Cobla IV -->
                <lg type="stanza" n="4.1" rhyme="abbaccddaa">

