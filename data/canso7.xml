                <div type="testo">
                   <div type="txt_critico" xml:id="canso7">
                    <title>Testo critico</title>
                    <p>Ms. base S
                        <lb/>Correzioni da <seg type="corr">C</seg>
                                <lb/>
                        <seg type="edit">Interventi editoriali</seg>
                    </p>
                    <!-- Cobla I -->
                    <label>I</label>
<lg type="stanza" n="1" rhyme="aaabbaaabbcc">
    <l n="1">Oimais, de vos non <rhyme label="a">aten</rhyme>
                                </l>
    <l n="2">aver <rhyme label="a">iausimen</rhyme>,</l>
    <l n="3">Amors, pois tan <rhyme label="a">loniamen</rhyme>
                                </l>
    <l n="4">me soi <rhyme label="b">faidiaz</rhyme>,</l>
    <l n="5">celant et sufrend en <rhyme label="b">paz</rhyme>
                                </l>
    <l n="6">L’afan e·l <rhyme label="a">turmen</rhyme>.</l>
    <l n="7">Mais er quan <seg type="corr">m'en vau</seg> <rhyme label="a">plagnen</rhyme>
                                </l>
    <l n="8">ni m’en clam, non val <rhyme label="a">nien</rhyme>.</l>
    <l n="9">Mais del clam q’eu <rhyme label="b">faz</rhyme>
                                </l>
    <l n="10">mi tegn per <rhyme label="b">pagaz</rhyme>,</l>
    <l n="11">d’aitan que se no m’es <rhyme label="c">pros</rhyme>,</l>
    <l n="12">blasmes er sivals a <rhyme label="c">vos</rhyme>.</l>
</lg>

<lb/>

<!-- Cobla II -->
<label>II</label>
<lg type="stanza" n="2" rhyme="aaabbaaabbcc">
    <l n="13">Blasmar vos degr’eu <rhyme label="a">fortmen</rhyme>,</l>
    <l n="14">mais vau vos <rhyme label="a">sofren</rhyme>,</l>
    <l n="15">qu’aicel que s’irais <rhyme label="a">greumen</rhyme>,</l>
    <l n="16">plus quant es <rhyme label="b">iraz</rhyme>,</l>
    <l n="17">es fels et <rhyme label="b">desmesuraz</rhyme>.</l>
    <l n="18">Doncs tem, s’eu <rhyme label="a">m’espren</rhyme>,</l>
    <l n="19">que vos e mei chan <rhyme label="a">plazen</rhyme>
                                </l>
    <l n="20">en serez trop <seg type="corr">meins</seg> <rhyme label="a">valen</rhyme>.</l>
    <l n="21">Per que vol <rhyme label="b">sapchaz</rhyme>,</l>
    <l n="22">se no·us <rhyme label="b">melloraz</rhyme>,</l>
    <l n="23">
                                    <seg type="edit">tan descarrai <rhyme label="c">andos</rhyme>
                                    </seg>,</l>
    <l n="24">Amors, vos et <seg type="corr">mas</seg> <rhyme label="c">chanzos</rhyme>.</l>
</lg>

<lb/>

<!-- Cobla III -->
<label>III</label>
<lg type="stanza" n="3" rhyme="aaabbaaabbcc">
    <l n="25">Ben soi fols car eu <rhyme label="a">aten</rhyme>
                                </l>
    <l n="26">null <rhyme label="a">melloramen</rhyme>,</l>
    <l n="27">qu’ades on plus vos <rhyme label="a">repren</rhyme>
                                </l>
    <l n="28">com amics <rhyme label="b">privaz</rhyme>,</l>
    <l n="29">vos cressez et <rhyme label="b">peioraz</rhyme>
                                </l>
    <l n="30">vostre <rhyme label="a">fallimen</rhyme>.</l>
    <l n="31">Et qui, per <rhyme label="a">castiamen</rhyme>
                                </l>
    <l n="32">ne per blasme de la <rhyme label="a">gen</rhyme>,</l>
    <l n="33">no tem far <rhyme label="b">foldaz</rhyme>,</l>
    <l n="34">es <rhyme label="b">desvergognaz</rhyme>,</l>
    <l n="35">et qui non es <rhyme label="c">vergognos</rhyme>
                                </l>
    <l n="36">non er ia valenz ni <rhyme label="c">bos</rhyme>.</l>
</lg>

<lb/>

<!-- Cobla IV -->
<label>IV</label>
<lg type="stanza" n="4" rhyme="aaabbaaabbcc">
    <l n="37">Et si sai que non es <rhyme label="a">gen</rhyme>
                                </l>
    <l n="38">quar ab vos <rhyme label="a">conten</rhyme>,</l>
    <l n="39">mas fatz lo <rhyme label="a">forzadamen</rhyme>,</l>
    <l n="40">quar me <rhyme label="b">malmenaz</rhyme>,</l>
    <l n="41">don eu soi tan <rhyme label="b">forsenaz</rhyme>
                                </l>
    <l n="42">q’eu no posc dir <rhyme label="a">sen</rhyme>.</l>
    <l n="43">Et s’eu dic <rhyme label="a">deschauzimen</rhyme>
                                </l>
    <l n="44">contra vos, pois <seg type="edit">forsatz <rhyme label="a">m’en</rhyme>
                                    </seg>,</l>
    <l n="45">er tort et <rhyme label="b">pechaz</rhyme>
                                </l>
    <l n="46">s’eu en soi <rhyme label="b">blasmaz</rhyme>.</l>
    <l n="47">Et vos tang lo <seg type="corr">mals</seg> <rhyme label="c">resos</rhyme>
                                </l>
    <l n="48">don mou·l torz e l’<rhyme label="c">ochasos</rhyme>.</l>
</lg>
<lb/>
                    <!-- Cobla V -->
                    <label>V</label>
                    <lg type="stanza" n="5" rhyme="aaabbaaabbcc">
                        <l n="49">Ben soi <seg type="corr">fols</seg>, ad <rhyme label="a">escien</rhyme>,
                        </l>
                        <l n="50">quar gast et <rhyme label="a">despen</rhyme>
                        </l>
                        <l n="51">en vos mon <rhyme label="a">castiamen</rhyme>,</l>
                        <l n="52">Amors, qe·l <rhyme label="b">maltaz</rhyme>
                        </l>
                        <l n="53">e·l <seg type="corr">folors</seg> e·l <rhyme label="b">crueltaz</rhyme>
                        </l>
                        <l n="54">qui en vos <rhyme label="a">s'enpren</rhyme>
                        </l>
                        <l n="55">no·us lais c’aver <rhyme label="a">chauzimen</rhyme>,</l>
                        <l n="56">anz vos tol et vos <rhyme label="a">defen</rhyme>
                        </l>
                        <l n="57">que ren non <rhyme label="b">creaz</rhyme>.</l>
                        <l n="58">Mas per so no·m <rhyme label="b">taz</rhyme>,</l>
                        <l n="59">anz sofrirai <rhyme label="c">pensasos</rhyme>
                        </l>
                        <l n="60">tro veia meiller <rhyme label="c">sasos</rhyme>.</l>
                    </lg>
                    <lb/>

                    <!-- Tornada -->
                    <label>VI</label>
                    <lg type="envoy" n="tornada" rhyme="aaabbbc">
                        <l n="61">Canpagna, be·us <rhyme label="a">pren</rhyme>
                        </l>
                        <l n="62">quar donpn’avez ses <rhyme label="a">contenpn</rhyme>
                        </l>
                        <l n="63">ses par de prez et de <rhyme label="a">sen</rhyme>
                        </l>
                        <l n="64">don vos <rhyme label="b">melloraz</rhyme>,</l>
                        <l n="65">qu’ill fai vas toz <rhyme label="b">laz</rhyme>
                        </l>
                        <l n="66">a son ric prez <rhyme label="c">cabalos</rhyme>
                        </l>
                        <l n="67">Espaigna grazir et <rhyme label="c">vos</rhyme>.</l>
                    </lg>
                    <lb/>
