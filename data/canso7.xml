        <text type="txt_costellazione" xml:id="canso7.1">
            <front>
                            <head>Testo di costellazione α</head>
                <p>Ms. base C <lb/>Correzioni e <seg type="it">tornada</seg> da <seg type="corr_c">E</seg>
                </p>
                </front>
                <body>
                <!-- Cobla I -->
                <lb/>
<lg type="stanza" n="1" rhyme="aaabbaaabbcc" xml:id="cos1" corresp="#crt1">
                <anchor xml:id="anchor-cos1"/>
    <l n="1">Hueymais, de vos non <rhyme label="a">aten</rhyme>
                                </l>
    <l n="2">aver <rhyme label="a">iauzimen</rhyme>,</l>
    <l n="3">Amors, <seg type="diff_c" xml:id="v3_cos" corresp="#v3">mas</seg> tan <rhyme label="a">lonjamen</rhyme>
                                </l>
    <l n="4">mi suy <rhyme label="b">fadiatz</rhyme>,</l>
    <l n="5">celan e sufren en <rhyme label="b">patz</rhyme>
                                </l>
    <l n="6">l’afan e·l <rhyme label="a">turmen</rhyme>.</l>
    <l n="7">Mas er quan m’en vauc <rhyme label="a">planhen</rhyme>
                                </l>
    <l n="8">ni m’en clam, no·m val <rhyme label="a">nien</rhyme>.</l>
    <l n="9">mas del clam qu’ieu <rhyme label="b">fatz</rhyme>
                                </l>
    <l n="10">mi tenh per <rhyme label="b">paguatz</rhyme>,</l>
    <l n="11">
                                    <seg type="edit">d’aitan</seg> que si no m’es <rhyme label="c">pros</rhyme>,</l>
    <l n="12">blasmes er sivals a <rhyme label="c">vos</rhyme>.</l>
