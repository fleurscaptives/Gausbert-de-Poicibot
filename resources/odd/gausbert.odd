    <text>
        <body>
            <schemaSpec start="TEI teiCorpus" source="teipublisher.odd">
        
                <elementSpec ident="lg" mode="change">
                    <model predicate="parent::div[@type='txt_critico']" behaviour="block">
                        <outputRendition xml:space="preserve">
                            margin: 1em;
                            padding: 1em;
                            border-radius: 10px;
                            text-align: left;
                        </outputRendition>
                    </model>
                    <model predicate="parent::div[@type='txt_costellazione']" behaviour="block">
                        <outputRendition xml:space="preserve">
                            border-radius: 10px;
                            text-align: left;
                        </outputRendition>
                    </model>
                </elementSpec>
                
<elementSpec ident="ref" mode="change">
    <model behaviour="link">
        <param name="uri" value="@target"/>
        <param name="target" value="'_blank'"/>
        <param name="class" value="@rend"/>
    </model>
</elementSpec>
                
<elementSpec ident="listApp" mode="change">
    <model behaviour="block"/>
</elementSpec>
<elementSpec ident="app" mode="change">
    <model predicate="@type='locus'" cssClass="loci" behaviour="inline"/>
    <model behaviour="inline"/>
</elementSpec>
<elementSpec ident="witDetail" mode="change">
    <model behaviour="inline">
        <param name="content" value="."/>
    </model>
</elementSpec>
<elementSpec ident="num" mode="change">
    <model behaviour="inline">
        <param name="content" value="concat(. , '. ')"/>
        <outputRendition>
                font-weight: bold;
                margin-left: 0.3em;
        </outputRendition>
    </model>
</elementSpec>
<elementSpec ident="term" mode="change">
      <model predicate="@type='glossario'" behaviour="inline" pb:mode="change" cssClass="glossario"/>
      <model predicate="@type='lex' or @type='lit'" behaviour="inline" cssClass="lex_lit">
      </model>
</elementSpec>
<elementSpec ident="seg" mode="change">
        <model predicate="@type='corr'" behaviour="inline" pb:mode="change">
            <outputRendition xml:space="preserve">
                 font-weight: bold;
                 color: #588157;
                text-shadow:
                -1px -1px white,
                1px -1px 0 white,
                -1px 1px 0 white,
                1px 1px 0 white,
                -1px 0px 0 white,
                1px 0px 0 white,
                0px -1px 0 white,
                0px 1px 0 white;
            </outputRendition>
        </model>
        <model predicate="@type='corr_c'" behaviour="inline">
            <outputRendition xml:space="preserve">
                font-weight: bold;
                color: #a3320b;
            </outputRendition>
        </model>
        <model predicate="parent::item" behaviour="inline">
                <outputRendition xml:space="preserve">
                    font-style: oblique;
                </outputRendition>
        </model>
        <model predicate="@type='edit'" behaviour="inline">
            <outputRendition xml:space="preserve">
                    text-decoration:underline;
                    text-underline-offset: 4.5px;
            </outputRendition>
        </model>
         <model predicate="@type='diff'" behaviour="inline" cssClass="diff"/>
        <model predicate="@type='diff_c'" behaviour="inline" cssClass="diff_cst">
           <param name="corresp" value="substring-after(@corresp, '#')"/>
           <pb:template xmlns="" xml:space="preserve">
               <span class="diff_cst" data-corresp="[[corresp]]">[[content]]</span>
           </pb:template>
        </model>
        <model predicate="@type='it'" behaviour="inline" cssClass="italic"/>


</elementSpec>
<elementSpec mode="change" ident="l">
  <modelSequence>
    <model predicate="(number(@n) mod 5) = 0" behaviour="inline" cssClass="num_versi">
       <param name="content" value="@n"/>
            <outputRendition>font-size: 13px; color: grey; display: inline;</outputRendition>
    </model>
    <model behaviour="block">
    </model>
  </modelSequence>
</elementSpec>
<elementSpec mode="change" ident="note">
<model predicate="@type='popup'" behaviour="inline">
    <param name="id" value="@xml:id"/>
    <param name="content" value="."/>
    <pb:template xmlns="" xml:space="preserve">
        <span class="trigger" id="[[id]]"> ⁕</span>
        <pb-popover for="[[id]]" theme="material">[[content]]</pb-popover>
    </pb:template>
</model>
<model predicate="@type='popup_cont'" behaviour="inline">
    <param name="id" value="@xml:id"/>
    <param name="content" value="."/>
    <pb:template xmlns="" xml:space="preserve">
        <span class="trigger1" id="[[id]]"> 𖣢</span>
        <pb-popover for="[[id]]" theme="material">[[content]]</pb-popover>
    </pb:template>
</model>
<model predicate="@type='text'" behaviour="inline">
<outputRendition>font-style: italic;</outputRendition>
</model>
</elementSpec>
                <elementSpec ident="lem" mode="change">
                    <model behaviour="inline">
                      <param name="content" value="concat(. , '] ')"/>
                    </model>
                </elementSpec>
            <elementSpec ident="div" mode="change">
                    <model predicate="@type='app_cos_form' or @type='app_crt_form'" behaviour="inline">
            <outputRendition xml:space="preserve">
            font-size: 18px;
            </outputRendition>
                    </model>
                    <model predicate="@type='biblio'" behaviour="block" cssClass="section-ed">
                    </model>
            <model predicate="parent::div[@type='biblio']" behaviour="block">
              <outputRendition>
                  width: 40%;
    display: inline-block;
    vertical-align: top;
              </outputRendition>
            </model>
        <model predicate="@type='trad_extra'" behaviour="inline" cssClass="extra_container">
        </model>
                    <model predicate="$parameters?mode = 'register'" behaviour="pass-through">
            <desc>Output register data if register profile is enabled</desc>
            <param name="people" value="let $refs := (root(.)//persName[@key or @ref], root(.)//rs[@type='person'][@key or @ref]) let $keys := for $i in ($refs/@key, $refs/@ref) return $i ! tokenize(., ' ')  for $key in distinct-values($keys) return collection($global:register-root)/id($key)[self::person]"/>
            <param name="places" value="let $refs := (root(.)//placeName[@key or @ref], root(.)//rs[@type='place'][@key or @ref]) let $keys := for $i in ($refs/@key, $refs/@ref) return $i ! tokenize(., ' ')  for $key in distinct-values($keys) return collection($global:register-root)/id($key)[self::place]"/>
            <pb:template xml:space="preserve"><div xmlns="" class="register">
<h3><pb-i18n key="register-details.people">ppl</pb-i18n></h3>
<ul>
[[people]]
</ul>

<h3><pb-i18n key="register-details.places">pl</pb-i18n></h3>
<ul>
[[places]]
</ul>
</div></pb:template>
        </model>
                </elementSpec>
            <elementSpec ident="body" mode="change">
                    <modelSequence>
            <model behaviour="index">
                <param name="type" value="'toc'"/>
            </model>
            <model behaviour="block"/>
        </modelSequence>
                </elementSpec>
                <elementSpec ident="text" mode="change">
                    <model behaviour="body"/>
                </elementSpec>
                <elementSpec ident="label" mode="change">
                    <model behaviour="block" cssClass="numerazione"/>
                </elementSpec>
<elementSpec ident="rhyme" mode="change" cssClass="scheda_rime">
    <model predicate="@type='a'" behaviour="inline" cssClass="scheda_rime">
        <outputRendition>background-color:#50a2a7;</outputRendition>
    </model>
    <model predicate="@type='b'" behaviour="inline" cssClass="scheda_rime">
        <outputRendition>background-color:#ff7d00;</outputRendition>
    </model>
    <model predicate="@type='c'" behaviour="inline" cssClass="scheda_rime">
        <outputRendition>background-color:#ce4257;</outputRendition>
    </model>
    <model predicate="@type='d'" behaviour="inline" cssClass="scheda_rime">
        <outputRendition>background-color:#deb841;</outputRendition>
    </model>
    <model predicate="@type='e'" behaviour="inline" cssClass="scheda_rime">
        <outputRendition>background-color:#7d8769;</outputRendition>
    </model>
</elementSpec>
            </schemaSpec>
        </body>
    </text>
</TEI>
