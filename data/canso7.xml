                <p>Ms. base C <lb/>Correzioni e <seg type="it">tornada</seg> da <seg type="corr_c">E</seg>
                </p>
                <!-- Cobla I -->
                <lb/>
<lg type="stanza" n="1" rhyme="aaabbaaabbcc">
    <l n="1">Hueymais, de vos non <rhyme label="a">aten</rhyme>
                                </l>
    <l n="2">aver <rhyme label="a">iauzimen</rhyme>,</l>
    <l n="3">Amors, mas tan <rhyme label="a">lonjamen</rhyme>
                                </l>
    <l n="4">mi suy <rhyme label="b">fadiatz</rhyme>,</l>
    <l n="5">celan e sufren en <rhyme label="b">patz</rhyme>
                                </l>
    <l n="6">l’afan e·l <rhyme label="a">turmen</rhyme>.</l>
    <l n="7">Mas er quan m’en vauc <rhyme label="a">planhen</rhyme>
                                </l>
    <l n="8">ni m’en clam, no·m val <rhyme label="a">nien</rhyme>.</l>
    <l n="9">mas del clam qu’ieu <rhyme label="b">fatz</rhyme>
                                </l>
    <l n="10">mi tenh per <rhyme label="b">paguatz</rhyme>,</l>
    <l n="11">
                                    <seg type="edit">d’aitan</seg> que si no m’es <rhyme label="c">pros</rhyme>,</l>
    <l n="12">blasmes er sivals a <rhyme label="c">vos</rhyme>.</l>
</lg>

<!-- Cobla II -->
<lb/>
<lg type="stanza" n="2" rhyme="aaabbaaabbcc">
    <l n="13">Blasmar vos degra <rhyme label="a">fortmen</rhyme>,</l>
    <l n="14">mas vauc <seg type="corr_c">vos</seg> <rhyme label="a">sufren</rhyme>,</l>
    <l n="15">quar sel que s’irays <rhyme label="a">greumen</rhyme>,</l>
    <l n="16">plus quant es <rhyme label="b">iratz</rhyme>,</l>
    <l n="17">e felhs ni <rhyme label="b">demezuratz</rhyme>.</l>
    <l n="18">Don tem, s’ieu mi <rhyme label="a">enpren</rhyme>,</l>
    <l n="19">que vos e mei chan <rhyme label="a">plazen</rhyme>
                                </l>
    <l n="20">en seretz trop meins <rhyme label="a">valen</rhyme>.</l>
    <l n="21">Per qu’ieu vuelh <rhyme label="b">sapchatz</rhyme>,</l>
    <l n="22">si no·us <rhyme label="b">meluyratz</rhyme>,</l>
    <l n="23">qu’ans dechairi’<rhyme label="c">ambedos</rhyme>,</l>
    <l n="24">
                                    <seg type="edit">Amors</seg>, vos e mas <rhyme label="c">chansos</rhyme>.</l>
</lg>

<!-- Cobla III -->
<lb/>
<lg type="stanza" n="3" xml:id="extra" rhyme="aaabbaaabbcc">
    <l n="25">Ben suy folhs quar hi <rhyme label="a">aten</rhyme>
                                </l>
    <l n="26">nul <rhyme label="a">meluyramen</rhyme>,</l>
    <l n="27">qu’ades on plus vos <rhyme label="a">repren</rhyme>
                                </l>
    <l n="28">cum amicx <rhyme label="b">privatz</rhyme>,</l>
    <l n="29">
                                    <seg type="corr_c">vos creisetz e <rhyme label="b">peiuratz</rhyme>
                                    </seg>
                                </l>
    <l n="30">vostre <rhyme label="a">falhimen</rhyme>.</l>
    <l n="31">E qui, per <rhyme label="a">castiamen</rhyme>
                                </l>
    <l n="32">ni per blasme de la <rhyme label="a">gen</rhyme>,</l>
    <l n="33">no tem far <rhyme label="b">foudatz</rhyme>,</l>
    <l n="34">es <rhyme label="b">desverguonhaz</rhyme>,</l>
    <l n="35">e qui non es <rhyme label="c">vergonhos</rhyme>
                                </l>
    <l n="36">non er ia valens ni <rhyme label="c">bos</rhyme>.</l>
</lg>

<!-- Cobla IV -->
<lb/>
<lg type="stanza" n="4" rhyme="aaabbaaabbcc">
    <l n="37">E say ben que no·m es <rhyme label="a">gen</rhyme>
                                </l>
    <l n="38">quar ab vos <rhyme label="a">conten</rhyme>,</l>
    <l n="39">mas <seg type="edit">fatz lo</seg> <rhyme label="a">forsadamen</rhyme>,</l>
    <l n="40">quar mi <rhyme label="b">malmenatz</rhyme>,</l>
    <l n="41">don ieu suy tan <rhyme label="b">forsenatz</rhyme>
                                </l>
    <l n="42">que no puesc dir <rhyme label="a">sen</rhyme>.</l>
    <l n="43">E s’ieu dic <rhyme label="a">deschauzimen</rhyme>
                                </l>
    <l n="44">contra vos, pois <seg type="edit">forsatz <rhyme label="a">m’en</rhyme>
                                    </seg>,</l>
    <l n="45">er tortz e <rhyme label="b">peccatz</rhyme>
                                </l>
    <l n="46">s’ieu en suy <rhyme label="b">blasmatz</rhyme>.</l>
    <l n="47">Qu’a <seg type="corr_c">vos</seg> tanh lo mals <rhyme label="c">ressos</rhyme>
                                </l>
    <l n="48">don ve·l tortz e l’<rhyme label="c">ochaizos</rhyme>.</l>
</lg>

<!-- Cobla V -->
<lb/>
<lg type="stanza" n="5" rhyme="aaabbaaabbcc">
    <l n="49">Ben suy folhs, ad <rhyme label="a">essien</rhyme>,</l>
    <l n="50">quar guast e <rhyme label="a">despen</rhyme>
                                </l>
    <l n="51">en vos mon <rhyme label="a">castiamen</rhyme>,</l>
    <l n="52">Amors, que·l <seg type="edit">
                                        <rhyme label="b">maltatz</rhyme>
                                    </seg>
                                </l>
    <l n="53">e·ylh follors e·ylh <rhyme label="b">crueltatz</rhyme>
                                </l>
    <l n="54">
                                    <seg type="edit">qui en vos <rhyme label="a">s'enpren</rhyme>
                                    </seg>
                                </l>
    <l n="55">
                                    <seg type="edit">no·us laiss’aver <rhyme label="a">chauzimen</rhyme>
                                    </seg>,</l>
    <l n="56">anz vos tolh e vos <rhyme label="a">defen</rhyme>
                                </l>
    <l n="57">que re non <rhyme label="b">crezatz</rhyme>.</l>
    <l n="58">Mas per so no·m <rhyme label="b">tatz</rhyme>,</l>
    <l n="59">quans sufriray <rhyme label="c">pezansos</rhyme>
                                </l>
    <l n="60">tro venha mielhers <rhyme label="c">sazos</rhyme>.</l>
</lg>

<!-- Tornada -->
